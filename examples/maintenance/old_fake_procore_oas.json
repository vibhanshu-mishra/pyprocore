{
  "openapi": "3.0.3",
  "info": {
    "title": "Fake Procore OAS (old)",
    "version": "1.0"
  },
  "paths": {
    "/rest/v1.0/projects/{project_id}/legacy_notes": {
      "get": {
        "operationId": "listLegacyNotes",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/rest/v1.0/projects/{project_id}/safety_reviews": {
      "get": {
        "operationId": "listSafetyReviews",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/rest/v1.0/projects/{project_id}/review_queue": {
      "get": {
        "operationId": "listReviewQueue"
      }
    }
  }
}
